# Copy to .env (never commit .env). Used by docker compose and, for the API, by pydantic-settings.
POSTGRES_USER=sales
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sales

# true everywhere except plain-HTTP local experiments (Safari drops Secure cookies over HTTP).
COOKIE_SECURE=true

# Outside Docker (pytest, alembic on the host) the API reads this instead:
# DATABASE_URL=postgresql+psycopg://sales:change-me@127.0.0.1:5432/sales

# Create the one user after the first start:
#   ADMIN_PASSWORD='a long password' docker compose exec -e ADMIN_PASSWORD api python -m app.cli create-user --name "Name"

# Local development only: a known throwaway login so the UI can be tried and tested on localhost.
# On any real or public installation choose your own long password instead.
# ADMIN_PASSWORD=dev-password-123

# ---- PRODUCTION ONLY (docker-compose.prod.yml; the full procedure is docs/DEPLOY.md) -------------
# Not read by the development stack, so they stay commented here: uncomment and fill in on the server.

# The address the iPad opens (its DNS record must already point at the server), and an email for
# the HTTPS certificate notices.
# DOMAIN=app.example.com
# ACME_EMAIL=you@example.com

# Where the encrypted backups go: a bucket OUTSIDE this server and at another company.
# Cloudflare R2: s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>   Backblaze B2: s3:https://s3.<region>.backblazeb2.com/<bucket>
# RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# Encrypts every backup. WITHOUT IT THE BACKUPS CANNOT BE READ, even by you: keep a copy in a
# password manager and one on paper, not only here.
# RESTIC_PASSWORD=
# Free check at healthchecks.io: it emails you when a backup does not arrive (the ping address).
# HC_URL=
# The very first start only: lets the backup service create the empty encrypted repository.
# Remove it afterwards: a wrong bucket name or wrong keys must fail loudly, not make a new repository.
# BACKUP_INIT=true
