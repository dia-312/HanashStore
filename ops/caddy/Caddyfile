{
	# Let's Encrypt asks for a contact address.
	email {$ACME_EMAIL}
}

# {$DOMAIN} is the address the iPad opens, for example app.example.com. Caddy gets and renews the
# HTTPS certificate by itself; the domain's DNS must point at this server first.
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000 {
			# Caddy faces the internet here, so what a client writes in X-Forwarded-For is never
			# trusted: the API gets exactly one address, the real client.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Product pictures: the API writes them to a shared volume and Caddy serves them from it. Each
	# file name contains its own id and is never rewritten, so browsers and the service worker can
	# keep it.
	handle_path /media/* {
		root * /media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# Hashed build files and fonts never change under the same URL.
		@immutable path /assets/* /fonts/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# The service worker and the HTML shell must always be revalidated.
		@shell path /sw.js /index.html /registerSW.js /manifest.webmanifest /
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
