{
	# TLS is terminated in front of this container (Cloudflare tunnel in development).
	auto_https off
	servers {
		# Keep the client IP that cloudflared / a proxy forwards, so the login rate limit sees it.
		trusted_proxies static private_ranges
		# With a chain (tunnel -> Caddy) the client is the right-most address that is not ours:
		# an X-Forwarded-For a client writes itself sits at the left and is ignored. (Found in QA:
		# without this, a different made-up address on every attempt skipped the login limit.)
		trusted_proxies_strict
	}
}

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000 {
			# The API trusts the first address of this header: send it exactly one, the real client.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Product images: the API writes them to a shared volume and Caddy serves them from it. Each file
	# name contains its own id and is never rewritten, so browsers and the service worker can keep it.
	handle_path /media/* {
		root * /media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# Hashed build files and fonts never change under the same URL.
		@immutable path /assets/* /fonts/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# The service worker and the HTML shell must always be revalidated.
		@shell path /sw.js /index.html /registerSW.js /manifest.webmanifest /
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		# The app is never shown inside another page; nothing is sent to other sites as a referrer;
		# no device sensor is asked for. (A full script/style policy needs a check on the iPad:
		# the picture export draws with inline styles. See docs/QA-REPORT.md.)
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
